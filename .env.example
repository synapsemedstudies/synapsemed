# Supabase Database & Auth (Free Tier supports 50,000 MAUs & 500 MB DB)
NEXT_PUBLIC_SUPABASE_URL="https://your-project-id.supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="your-supabase-anon-key"
SUPABASE_SERVICE_ROLE_KEY="your-supabase-service-role-key"
DATABASE_URL="postgresql://postgres.[your-project-ref]:[YOUR-PASSWORD]@aws-0-[region].pooler.supabase.com:6543/postgres"

# S3 Object Storage (Supabase Storage S3 or Cloudflare R2)
# OPTION A: Supabase Storage S3
R2_ENDPOINT="https://your-project-id.supabase.co/storage/v1/s3"
R2_REGION="us-east-1"
R2_ACCESS_KEY_ID="your-s3-access-key-id"
R2_SECRET_ACCESS_KEY="your-s3-secret-key"
R2_BUCKET_NAME="student-notes-portal"

# OPTION B: Cloudflare R2
# R2_ACCOUNT_ID="your-cloudflare-account-id"
# R2_ACCESS_KEY_ID="your-r2-access-key-id"
# R2_SECRET_ACCESS_KEY="your-r2-secret-access-key"
# R2_BUCKET_NAME="student-notes-portal"
